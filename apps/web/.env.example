# App role connection URL. Keep the real value in .env.local.
DATABASE_URL=

# Base URL of the app, including the protocol.
BETTER_AUTH_URL=http://localhost:3000

# Put a random 32-byte secret (encoded as Base64) in .env.local.
BETTER_AUTH_SECRET=

# Naver Login credentials. Keep both values in the server's .env.local.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
