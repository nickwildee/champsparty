{
  "name": "champsparty",
  "private": true,
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @champsparty/web dev",
    "db:check": "pnpm --filter @champsparty/web db:check",
    "db:migrate": "pnpm --filter @champsparty/web db:migrate",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "build": "pnpm --filter @champsparty/web build",
    "start": "pnpm --filter @champsparty/web start",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
